{
  "name": "dsh-windows-workspace-guard",
  "version": "2.0.0",
  "description": "Guard DeepSeek Harness PowerShell, file, image, and search tools on Windows with workspace, credential, approval, and audit policy.",
  "author": "julescules",
  "homepage": "https://github.com/julescules/dsh-windows-workspace-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julescules/dsh-windows-workspace-guard.git"
  },
  "bugs": {
    "url": "https://github.com/julescules/dsh-windows-workspace-guard/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./analyzer": "./analyzer.js",
    "./audit": "./audit.js",
    "./config-source": "./config-source.js",
    "./doctor": "./doctor.js",
    "./policy": "./policy.js",
    "./path-guard": "./path-guard.js",
    "./runtime-guard": "./runtime-guard.js",
    "./tool-adapters": "./tool-adapters.js",
    "./sensitive": "./sensitive.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "analyzer.js",
    "audit.js",
    "audit-summary.js",
    "config-source.js",
    "doctor.js",
    "policy.js",
    "path-guard.js",
    "runtime-guard.js",
    "tool-adapters.js",
    "scripts/build-release-metadata.mjs",
    "scripts/verify-release.ps1",
    "sensitive.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/demo.svg",
    "docs/demo.png",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check analyzer.js && node --check audit.js && node --check config-source.js && node --check doctor.js && node --check policy.js && node --check path-guard.js && node --check runtime-guard.js && node --check sensitive.js && node --check tool-adapters.js && npm test",
    "pack:dry": "npm pack --dry-run",
    "release:metadata": "node scripts/build-release-metadata.mjs",
    "test:host": "node scripts/verify-host.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "powershell",
    "windows",
    "workspace-safety",
    "audit-log",
    "git-safety",
    "approval-policy",
    "settings-card",
    "windows-security",
    "agent-security",
    "credential-protection"
  ],
  "license": "MIT"
}
