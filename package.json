{
  "name": "dsh-windows-workspace-guard",
  "version": "0.5.0",
  "description": "Persistent PowerShell, Windows workspace, system-mutation, Git-risk, approval, settings, and audit guard for DeepSeek Harness.",
  "author": "julescules",
  "homepage": "https://github.com/julescules/dsh-windows-workspace-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julescules/dsh-windows-workspace-guard.git"
  },
  "bugs": {
    "url": "https://github.com/julescules/dsh-windows-workspace-guard/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./analyzer": "./analyzer.js",
    "./audit": "./audit.js",
    "./config-source": "./config-source.js",
    "./policy": "./policy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "analyzer.js",
    "audit.js",
    "config-source.js",
    "policy.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/demo.svg",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check analyzer.js && node --check audit.js && node --check config-source.js && node --check policy.js && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <0.1.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": ">=19.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "powershell",
    "windows",
    "workspace-safety",
    "audit-log",
    "git-safety",
    "approval-policy",
    "settings-card",
    "windows-security"
  ],
  "license": "MIT"
}
